# Supply-chain hardening — policy: agents-hub vault/Processes/servers-security-deployment.md
save-exact=true        # new installs pin exact versions (no ^/~ ranges)
ignore-scripts=true    # block dependency pre/post-install scripts (the payload vector in recent npm worms)
fund=false

# Zero-day gate (not yet enabled): delays installing versions newer than N days.
# npm 11.8 ignores `min-release-age` as unknown config, so leaving it off until npm
# ships it reliably. For deliberate manual sweeps use: npm install --before=<~14 days ago>
# min-release-age=14
